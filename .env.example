# Police roster spreadsheet (read-only to the website)
GOOGLE_SHEET_ID=YOUR_OFFICERS_SPREADSHEET_ID
GOOGLE_SHEET_RANGE=officers!B4:H
GOOGLE_SHEETS_API_KEY=OPTIONAL_READ_ONLY_FALLBACK_KEY
SHEET_SYNC_TTL_MS=60000

# Separate persistent academy/system-data spreadsheet (service account = Editor)
ACADEMY_GOOGLE_SHEET_ID=YOUR_SYSTEM_DATA_SPREADSHEET_ID
ACADEMY_GOOGLE_SHEET_NAME=System Data
# Backward-compatible aliases accepted by the backend:
GOOGLE_ACADEMY_DATA_SHEET_ID=
GOOGLE_ACADEMY_DATA_SHEET_NAME=

# Render Secret File: google-service-account.json
GOOGLE_SERVICE_ACCOUNT_FILE=/etc/secrets/google-service-account.json

# Discord OAuth2
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=PUT_DISCORD_CLIENT_SECRET_IN_RENDER_ONLY
DISCORD_REDIRECT_URI=https://kayan-police-academy.onrender.com/auth/discord/callback
FRONTEND_URL=https://kayan-police-academy.onrender.com

# Academy Super Admin
ACADEMY_ADMIN_IDS=YOUR_DISCORD_USER_ID

# Session signing: long random secret, never commit the real value
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET_AND_STORE_IT_IN_RENDER
PORT=10000
NODE_ENV=production
