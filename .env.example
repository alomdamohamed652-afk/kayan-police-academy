# Google Sheets
# Police roster source. Keep the range aligned with the sheet layout used by the server.
GOOGLE_SHEET_ID=1J1cWiWn_yOhy3G7coTOwq6AoS9OZvW8rul1_gzZ8uRc
GOOGLE_SHEET_RANGE=officers!B4:H

# Option A: read-only API key (roster reading only)
GOOGLE_SHEETS_API_KEY=PUT_YOUR_READ_ONLY_GOOGLE_SHEETS_API_KEY_HERE

# Option B: service account JSON for persistent academy data + roster access.
# Do NOT commit the real JSON/key to GitHub. Put it in Render environment variables.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

SHEET_SYNC_TTL_MS=30000
GOOGLE_ACADEMY_DATA_SHEET_NAME=ACADEMY_DATA

# Discord OAuth2
DISCORD_CLIENT_ID=1540106397591543939
# NEVER commit the real Discord Client Secret to GitHub.
DISCORD_CLIENT_SECRET=PUT_DISCORD_CLIENT_SECRET_IN_RENDER_ONLY
DISCORD_REDIRECT_URI=https://kayan-police-academy.onrender.com/auth/discord/callback
FRONTEND_URL=https://kayan-police-academy.onrender.com

# Academy Super Admin
ACADEMY_ADMIN_IDS=798195732855128124

# Session signing
# Use a long random secret (at least 32 characters in production).
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET_AND_STORE_IT_IN_RENDER
PORT=3001
NODE_ENV=production
